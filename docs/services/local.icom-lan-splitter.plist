<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.icom-lan-splitter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/YOUR_USER/icom-splitter/src/cli.js</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/YOUR_USER/icom-splitter</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>ICOM_RADIO_HOST</key><string>10.0.1.25</string>
        <key>ICOM_USERNAME</key><string>your-radio-user</string>
        <key>ICOM_PASSWORD_FILE</key><string>/Users/YOUR_USER/.config/icom-splitter/password</string>
        <key>ICOM_BIND_ADDRESS</key><string>192.168.1.20</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>StandardOutPath</key><string>/Users/YOUR_USER/Library/Logs/icom-splitter.log</string>
    <key>StandardErrorPath</key><string>/Users/YOUR_USER/Library/Logs/icom-splitter-error.log</string>
</dict>
</plist>
